{
  "name": "@acmelabs/brain",
  "version": "0.4.0",
  "private": true,
  "description": "A development lifecycle for coding agents: agent-skills wrapped with a glossary, plain talk, and one question at a time.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint scripts oxlint.config.ts oxfmt.config.ts",
    "format": "oxfmt scripts oxlint.config.ts oxfmt.config.ts",
    "format:check": "oxfmt --check scripts oxlint.config.ts oxfmt.config.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test && bun run version:sync -- --check && bun run plain-talk:render -- --check && bun run lifecycle:check && bun run question:check",
    "test": "bun test",
    "sync": "bun run scripts/sync/sync.ts",
    "version:sync": "bun run scripts/version/version-sync.ts",
    "validate": "bun run scripts/validate.ts",
    "changeset": "changeset",
    "version": "changeset version && bun run version:sync",
    "plain-talk:render": "bun run scripts/plain-talk/render.ts",
    "setup:write": "bun run scripts/setup/write.ts",
    "lifecycle:check": "bun run scripts/lifecycle/check-refs.ts",
    "question:check": "bun run scripts/question/check.ts",
    "evals:gate": "bun run scripts/evals/gate.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@types/bun": "^1.3.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "^5.6.0",
    "ultracite": "7.12.0"
  }
}
